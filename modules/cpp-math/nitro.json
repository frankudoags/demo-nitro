{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "cppmath"
  ],
  "ios": {
    "iosModuleName": "NitroCppMath"
  },
  "android": {
    "androidNamespace": [
      "cppmath"
    ],
    "androidCxxLibName": "NitroCppMath"
  },
  "autolinking": {
    "CppMath": {
      "ios": {
        "language": "c++",
        "implementationClassName": "HybridCppMath"
      },
      "android": {
        "language": "c++",
        "implementationClassName": "HybridCppMath"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
