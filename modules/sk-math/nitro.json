{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "skmath"
  ],
  "ios": {
    "iosModuleName": "NitroSkMath"
  },
  "android": {
    "androidNamespace": [
      "skmath"
    ],
    "androidCxxLibName": "NitroSkMath"
  },
  "autolinking": {
    "SkMath": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridSkMath"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridSkMath"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
